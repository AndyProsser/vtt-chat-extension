{
  "manifest_version": 3,
  "name": "VTT-Chat DDB Connector",
  "version": "0.3.1",
  "description": "Launch VTT-Chat sessions directly from D&D Beyond.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "https://www.dndbeyond.com/*",
    "https://character-service.dndbeyond.com/*",
    "https://api.dndbeyond.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "type": "module",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/characters/*",
        "https://www.dndbeyond.com/campaigns/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@vtt-chat-extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["technicalAndInteraction"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}