{
  "name": "vtt-chat-extension",
  "version": "0.3.1",
  "description": "Browser extension to launch VTT-Chat sessions from D&D Beyond",
  "type": "module",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "node --test tests/**/*.test.js",
    "clean": "rm -rf build",
    "package": "npm run build && npm run package:firefox && npm run package:chrome && npm run package:edge",
    "package:firefox": "cd build/firefox && zip -r ../vtt-chat-ddb-connector-firefox.zip .",
    "package:chrome": "cd build/chrome && zip -r ../vtt-chat-ddb-connector-chrome.zip .",
    "package:edge": "cd build/edge && zip -r ../vtt-chat-ddb-connector-edge.zip ."
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "globals": {
      "chrome": "readonly",
      "browser": "readonly"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andyprosser/vtt-chat-extension.git"
  },
  "author": "Andy Prosser",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andyprosser/vtt-chat-extension/issues"
  },
  "homepage": "https://github.com/andyprosser/vtt-chat-extension#readme"
}